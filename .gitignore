# Root lockfile stays uncommitted so consumers are not pinned.
# CI uses .github/ci-manifest/Manifest.toml (leading slash = repo root only).
/Manifest.toml
/docs/build/
/docs/Manifest.toml
*.jld2
*.mem
*.log
*.cov
lcov.info


# Local environment variables (contains secrets — never commit)
.env
.mimocode/

# Local exploration / agent notes (never ship)
.explore-notes/
playground-results/
.cursor/
